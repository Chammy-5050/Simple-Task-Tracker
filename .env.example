# Copy to .env and adjust. Docker Compose reads .env automatically.

# PostgreSQL
POSTGRES_DB=smalltask
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Email (codes are sent by email only). Leave these unset to use the bundled
# Mailpit inbox at http://localhost:8025. For a real server, for example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
DEFAULT_FROM_EMAIL=Task Tracker <no-reply@tasktracker.local>

# Where links in emails point (the Next.js app) and where email images load from (this API).
FRONTEND_URL=http://localhost:3000
EMAIL_ASSET_BASE_URL=http://localhost:8001

# Rate-limit counters. Without REDIS_URL each process keeps its own counters in memory.
REDIS_URL=redis://redis:6379/0
# Code emails per hour, per IP and per address (resend and forgot password).
CODE_SEND_RATE=5/hour

# Uploaded profile pictures
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
